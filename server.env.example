# Copy to a private file outside the repository. Never use VITE_ for provider credentials.
APP_ORIGIN=http://localhost:5173
PORT=8787
# Use 0.0.0.0 only inside an isolated container without published ports.
GATEWAY_BIND_HOST=127.0.0.1
SUPABASE_URL=
SUPABASE_ANON_KEY=
GEMINI_API_KEY=
# Optional additional Gemini keys: GEMINI_API_KEY_1 through GEMINI_API_KEY_10
OPENROUTER_API_KEY=
GROQ_API_KEY=
TAVILY_API_KEY=

# Per-process provider dispatch limit across all verified sessions; tune to provider quotas.
GATEWAY_GLOBAL_REQUESTS_PER_MINUTE=120
